{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.example/schemas/aso-vnext-live-fixture-v1.json",
  "title": "Agent Swarm Orchestration vNext live fixture specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "case_contract_version", "target_package_version", "target_runtime_fingerprint", "execution_status", "case_id", "purpose", "workspace", "pre_state", "steps", "injection", "oracle", "forbidden_targets"],
  "properties": {
    "format": {"const": "aso-live-fixture/v1"},
    "case_contract_version": {"const": "aso-vnext-eval-contract/v1"},
    "target_package_version": {"const": "0.3.0"},
    "target_runtime_fingerprint": {"oneOf": [{"const": "PENDING_SOURCE_FREEZE"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "execution_status": {"const": "specified-not-run"},
    "case_id": {"type": "string", "pattern": "^ASO-L[0-9]{3}$"},
    "purpose": {"type": "string", "minLength": 1},
    "workspace": {"enum": ["disposable-temporary-directory", "disposable-git-repository"]},
    "pre_state": {"type": "object", "minProperties": 1},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "expected_recovery"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "expected_recovery": {"type": "string", "minLength": 1}
      }
    },
    "oracle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
