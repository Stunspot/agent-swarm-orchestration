{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.example/schemas/aso-vnext-experiment-suite-v1.json",
  "title": "Agent Swarm Orchestration vNext ablation suite specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "suite", "case_contract_version", "target_package_version", "target_runtime_fingerprint", "execution_status", "promotion_rule", "measures", "experiments"],
  "properties": {
    "format": {"const": "cd-augment-eval/v1"},
    "suite": {"const": "orchestration-role-synergy-ablation"},
    "case_contract_version": {"const": "aso-vnext-eval-contract/v1"},
    "target_package_version": {"const": "0.3.0"},
    "target_runtime_fingerprint": {"oneOf": [{"const": "PENDING_SOURCE_FREEZE"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "execution_status": {"const": "specified-not-run"},
    "promotion_rule": {"type": "string", "minLength": 1},
    "measures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimensions", "question", "arms", "repetitions", "budget_match", "randomization", "oracle", "promotion_threshold", "safety_gates"],
        "properties": {
          "id": {"type": "string", "pattern": "^ASO-X[0-9]{3}$"},
          "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "question": {"type": "string", "minLength": 1},
          "arms": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "repetitions": {"type": "integer", "minimum": 2},
          "budget_match": {"type": "string", "minLength": 1},
          "randomization": {"type": "string", "minLength": 1},
          "oracle": {"type": "string", "minLength": 1},
          "promotion_threshold": {"type": "string", "minLength": 1},
          "safety_gates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
