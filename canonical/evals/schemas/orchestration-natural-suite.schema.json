{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collaborative-dynamics.example/schemas/aso-vnext-natural-suite-v1.json",
  "title": "Agent Swarm Orchestration vNext natural qualification suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "suite", "case_contract_version", "target_package_version", "target_runtime_fingerprint", "skills", "runtime", "claim", "synthesis", "cases"],
  "properties": {
    "format": {"const": "cd-augment-eval/v1"},
    "suite": {"const": "orchestration-organization-natural-qualification"},
    "case_contract_version": {"const": "aso-vnext-eval-contract/v1"},
    "target_package_version": {"const": "0.3.1"},
    "target_runtime_fingerprint": {"oneOf": [{"const": "PENDING_SOURCE_FREEZE"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runtime": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "synthesis": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concern", "dimensions", "input", "expected_behaviors", "failure_signals"],
        "properties": {
          "id": {"type": "string", "pattern": "^ASO-ON[0-9]{3}$"},
          "concern": {"type": "string", "minLength": 1},
          "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "input": {"type": "string", "minLength": 1},
          "expected_behaviors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptable_variation": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "failure_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
